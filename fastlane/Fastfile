# Store uploads for the release workflow. Every credential comes from the
# environment, which release.yaml fills from repository secrets only when they
# all exist; docs/releasing.md lists them. Run locally with
# `bundle exec fastlane <platform> <lane>` and the same variables set.

# fastlane runs lane code from ./fastlane but actions from the project root, so
# every path below is absolute to keep the two from being confused.
ROOT = ENV.fetch("GITHUB_WORKSPACE") do
  Dir.pwd.end_with?("/fastlane") ? File.expand_path("..") : Dir.pwd
end

default_platform(:android)

platform :android do
  desc "Upload an App Bundle to the internal track, with the store text and the changelog for its version code"
  lane :internal do |options|
    aab = File.expand_path(options.fetch(:aab), ROOT)
    status = ENV["PLAY_RELEASE_STATUS"].to_s
    upload_to_play_store(
      track: "internal",
      aab: aab,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      # "draft" until the app has passed its first review: Play refuses a
      # completed release for an app that was never published.
      release_status: status.empty? ? "draft" : status,
      metadata_path: File.join(ROOT, "fastlane/metadata/android"),
      # Screenshots and the feature graphic are uploaded by hand in the Play
      # Console until real ones are committed; see docs/releasing.md.
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote a version code from the internal track to production, or with dry_run:true only check that it could be"
  lane :promote do |options|
    code = Integer(options.fetch(:code).to_s, 10)
    rollout = Float(options.fetch(:rollout, 100).to_s)
    dry_run = options[:dry_run].to_s == "true"
    UI.user_error!("rollout is a percentage above 0 and at most 100, not #{rollout}") unless rollout > 0 && rollout <= 100
    json = ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON")

    # Reading the tracks is also the credentials check: a bad key fails here.
    internal = google_play_track_version_codes(track: "internal", json_key_data: json)
    production = google_play_track_version_codes(track: "production", json_key_data: json)
    promote_report("Play internal track: #{internal.empty? ? "empty" : internal.join(", ")}")
    promote_report("Play production track: #{production.empty? ? "empty" : production.join(", ")}")
    unless internal.include?(code)
      promote_stop("Version code #{code} is not on the internal track, so there is nothing to promote", dry_run)
      next
    end

    # Same rule as the internal upload: "draft" until the app has passed its
    # first review. A draft has no user fraction, so a rollout waits for that.
    status = ENV["PLAY_RELEASE_STATUS"].to_s
    status = "draft" if status.empty?
    fraction = rollout < 100 ? rollout / 100 : nil
    if fraction && status == "draft"
      promote_warn("PLAY_RELEASE_STATUS is draft, so the #{rollout}% rollout is ignored; the release goes to production as a draft")
      fraction = nil
    end
    promote_report("#{dry_run ? "Would promote" : "Promoting"} version code #{code} to production: " \
                   "#{fraction ? "#{rollout}% staged rollout" : status}")

    # validate_only builds the whole edit and has Play check it, then drops it.
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: code,
      track_promote_release_status: status,
      rollout: fraction&.to_s,
      json_key_data: json,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: dry_run
    )
  end
end

require "open3"
require "plist"
require "tmpdir"
require "xcodeproj"

# Each signed target with its bundle id and the variable holding its App Store
# profile. Both carry the App Group the widgets read the app's data through.
IOS_SIGNING = {
  "Runner" => { bundle_id: "red.tix.tixMobile", profile: "IOS_PROFILE_PATH" },
  "TixWidgets" => { bundle_id: "red.tix.tixMobile.TixWidgets", profile: "IOS_WIDGETS_PROFILE_PATH" }
}.freeze
IOS_APP_GROUP = "group.red.tix.tixMobile"

# Fails before the build when a profile is for another team or bundle id, is
# not an App Store profile, or lacks the App Group.
def check_ios_profile(path, team, bundle_id)
  profile = FastlaneCore::ProvisioningProfile.parse(path)
  ent = profile.fetch("Entitlements", {})
  name = profile["Name"]
  problems = []
  problems << "is not for team #{team}" unless Array(profile["TeamIdentifier"]).include?(team)
  problems << "is not for #{bundle_id}" unless ent["application-identifier"] == "#{team}.#{bundle_id}"
  problems << "lists devices, so it is not an App Store profile" if profile.key?("ProvisionedDevices")
  problems << "lacks the App Group #{IOS_APP_GROUP}" unless Array(ent["com.apple.security.application-groups"]).include?(IOS_APP_GROUP)
  UI.user_error!("Profile \"#{name}\" #{problems.join(", ")}") unless problems.empty?
  name
end

# Signing entitlements of a bundle, as codesign reports them.
def signed_entitlements(path)
  out, err, status = Open3.capture3("codesign", "-d", "--entitlements", "-", "--xml", path)
  UI.user_error!("codesign could not read #{path}: #{err}") unless status.success?
  Plist.parse_xml(out) || {}
end

platform :ios do
  desc "Build an App Store signed IPA, app and widget extension, from the certificate and profiles in the environment"
  lane :ipa do
    team = ENV.fetch("APPLE_TEAM_ID")
    project = File.join(ROOT, "ios/Runner.xcodeproj")

    # The entitlements name the group as $(TIX_APP_GROUP); a different value
    # in either target would be signed in and break the widgets' shared data.
    targets = Xcodeproj::Project.open(project).targets
    IOS_SIGNING.each_key do |name|
      target = targets.find { |t| t.name == name } || UI.user_error!("No #{name} target in #{project}")
      group = target.build_configurations.find { |c| c.name == "Release" }&.build_settings&.fetch("TIX_APP_GROUP", nil)
      UI.user_error!("#{name} Release has TIX_APP_GROUP #{group.inspect}, not #{IOS_APP_GROUP}") unless group == IOS_APP_GROUP
    end

    # A throwaway keychain, deleted with the runner. Only acts on CI.
    setup_ci
    import_certificate(
      certificate_path: ENV.fetch("IOS_CERT_PATH"),
      certificate_password: ENV.fetch("IOS_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # ios/ExportOptions.plist is committed without a team or profiles, which
    # are account details; they are filled in on the runner's copy.
    plist = File.join(ROOT, "ios/ExportOptions.plist")
    options = Plist.parse_xml(plist)
    options["teamID"] = team
    options["provisioningProfiles"] = {}

    # The project keeps automatic signing for people building on their own
    # Mac. CI has no Apple ID to sign in with, so each target's Release
    # configuration is switched to its installed profile for this build only.
    IOS_SIGNING.each do |target, spec|
      path = ENV.fetch(spec[:profile])
      profile_name = check_ios_profile(path, team, spec[:bundle_id])
      install_provisioning_profile(path: path)
      update_code_signing_settings(
        path: project,
        use_automatic_signing: false,
        targets: [target],
        build_configurations: ["Release"],
        team_id: team,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name
      )
      options["provisioningProfiles"][spec[:bundle_id]] = profile_name
    end
    File.write(plist, Plist::Emit.dump(options))

    Dir.chdir(ROOT) { sh("just", "build-ipa") }

    # What TestFlight gets: the IPA, with the extension inside it and both
    # signed for their bundle id and the App Group.
    ipa = Dir[File.join(ROOT, "build/ios/ipa/*.ipa")].first || UI.user_error!("No IPA under build/ios/ipa")
    Dir.mktmpdir do |dir|
      sh("ditto", "-x", "-k", ipa, dir)
      app = Dir[File.join(dir, "Payload/*.app")].first || UI.user_error!("No app in #{ipa}")
      bundles = { app => IOS_SIGNING["Runner"], File.join(app, "PlugIns/TixWidgets.appex") => IOS_SIGNING["TixWidgets"] }
      bundles.each do |bundle, spec|
        UI.user_error!("#{File.basename(bundle)} is missing from #{ipa}") unless File.directory?(bundle)
        ent = signed_entitlements(bundle)
        UI.user_error!("#{File.basename(bundle)} is not signed for #{spec[:bundle_id]}") unless ent["application-identifier"] == "#{team}.#{spec[:bundle_id]}"
        UI.user_error!("#{File.basename(bundle)} is signed without #{IOS_APP_GROUP}") unless Array(ent["com.apple.security.application-groups"]).include?(IOS_APP_GROUP)
        UI.success("#{File.basename(bundle)}: #{spec[:bundle_id]}, #{IOS_APP_GROUP}")
      end
    end
  end

  desc "Upload an IPA to TestFlight with the App Store Connect API key in the environment"
  lane :testflight do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_BASE64"),
      is_key_content_base64: true
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: File.expand_path(options.fetch(:ipa), ROOT),
      # Processing takes minutes to an hour; the build appears in App Store
      # Connect on its own and nothing here depends on it.
      skip_waiting_for_build_processing: true
    )
  end

  desc "Submit a version's newest processed TestFlight build for App Store review, or with dry_run:true only check that it could be"
  lane :promote do |options|
    version = options.fetch(:version).to_s
    dry_run = options[:dry_run].to_s == "true"
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_BASE64"),
      is_key_content_base64: true
    )

    # Looking the app up is also the credentials check: a bad key fails here.
    app = Spaceship::ConnectAPI::App.get(app_id: APP_STORE_APP_ID)
    unless app&.bundle_id == "red.tix.tixMobile"
      UI.user_error!("App Store Connect app #{APP_STORE_APP_ID} is not red.tix.tixMobile")
    end
    platform = Spaceship::ConnectAPI::Platform::IOS
    states = Spaceship::ConnectAPI::AppStoreVersion::AppVersionState
    live = app.get_live_app_store_version(platform: platform)
    edit = app.get_edit_app_store_version(platform: platform)
    promote_report("App Store: live #{live ? live.version_string : "none"}, " \
                   "in progress #{edit ? "#{edit.version_string} (#{edit.app_version_state})" : "none"}")

    if live&.version_string == version
      promote_stop("#{version} is already on the App Store, so there is nothing to submit", dry_run)
      next
    end
    if app.get_in_progress_review_submission(platform: platform)
      promote_stop("A review submission is already in progress; wait for it or cancel it in App Store Connect", dry_run)
      next
    end
    # deliver cannot answer App Review: a rejected version goes back from the
    # website, with a reply in Resolution Center.
    if edit && [states::REJECTED, states::METADATA_REJECTED].include?(edit.app_version_state)
      promote_stop("#{edit.version_string} was rejected; resubmit it from App Store Connect", dry_run)
      next
    end

    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: version,
      processing_states: Spaceship::ConnectAPI::Build::ProcessingState::VALID,
      platform: platform
    ).reject(&:expired)
    build = builds.max_by { |b| b.version.to_i }
    unless build
      promote_stop("No processed TestFlight build of #{version}, so there is nothing to submit", dry_run)
      next
    end
    promote_report("#{dry_run ? "Would submit" : "Submitting"} #{version} build #{build.version} for App Store review")
    next if dry_run

    upload_to_app_store(
      api_key: api_key,
      app_version: version,
      build_number: build.version,
      skip_binary_upload: true,
      skip_screenshots: true,
      # The App Store text and screenshots are kept in App Store Connect,
      # not in the repository.
      skip_metadata: true,
      submit_for_review: true,
      force: true,
      # precheck cannot read in-app purchases with an API key, and App Review
      # checks the listing anyway.
      run_precheck_before_submit: false,
      # HTTPS and the Go standard library's TLS only, which is exempt.
      submission_information: { export_compliance_uses_encryption: false }
    )
  end
end

APP_STORE_APP_ID = "6834556706"

# A line for the log and for the run's summary page.
def promote_report(line)
  UI.message(line)
  summary = ENV["GITHUB_STEP_SUMMARY"].to_s
  File.write(summary, "#{line}\n", mode: "a") unless summary.empty?
end

def promote_warn(line)
  # $stdout, because fastlane routes a bare puts through its timestamped logger
  # and GitHub only reads a workflow command at the start of a line.
  $stdout.puts("::warning::#{line}") if ENV["GITHUB_ACTIONS"] == "true"
  promote_report(line)
end

# Nothing to promote: a warning on a dry run, which only reports, and a
# failure on a real one, which was asked to change something.
def promote_stop(line, dry_run)
  UI.user_error!(line) unless dry_run
  promote_warn(line)
end
