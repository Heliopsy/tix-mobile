# Store uploads for the release workflow. Every credential comes from the
# environment, which release.yaml fills from repository secrets only when they
# all exist; docs/releasing.md lists them. Run locally with
# `bundle exec fastlane <platform> <lane>` and the same variables set.

# fastlane runs lane code from ./fastlane but actions from the project root, so
# every path below is absolute to keep the two from being confused.
ROOT = ENV.fetch("GITHUB_WORKSPACE") do
  Dir.pwd.end_with?("/fastlane") ? File.expand_path("..") : Dir.pwd
end

default_platform(:android)

platform :android do
  desc "Upload an App Bundle to the internal track, with the store text and the changelog for its version code"
  lane :internal do |options|
    aab = File.expand_path(options.fetch(:aab), ROOT)
    status = ENV["PLAY_RELEASE_STATUS"].to_s
    upload_to_play_store(
      track: "internal",
      aab: aab,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      # "draft" until the app has passed its first review: Play refuses a
      # completed release for an app that was never published.
      release_status: status.empty? ? "draft" : status,
      metadata_path: File.join(ROOT, "fastlane/metadata/android"),
      # Screenshots and the feature graphic are uploaded by hand in the Play
      # Console until real ones are committed; see docs/releasing.md.
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

require "open3"
require "plist"
require "tmpdir"
require "xcodeproj"

# Each signed target with its bundle id and the variable holding its App Store
# profile. Both carry the App Group the widgets read the app's data through.
IOS_SIGNING = {
  "Runner" => { bundle_id: "red.tix.tixMobile", profile: "IOS_PROFILE_PATH" },
  "TixWidgets" => { bundle_id: "red.tix.tixMobile.TixWidgets", profile: "IOS_WIDGETS_PROFILE_PATH" }
}.freeze
IOS_APP_GROUP = "group.red.tix.tixMobile"

# Fails before the build when a profile is for another team or bundle id, is
# not an App Store profile, or lacks the App Group.
def check_ios_profile(path, team, bundle_id)
  profile = FastlaneCore::ProvisioningProfile.parse(path)
  ent = profile.fetch("Entitlements", {})
  name = profile["Name"]
  problems = []
  problems << "is not for team #{team}" unless Array(profile["TeamIdentifier"]).include?(team)
  problems << "is not for #{bundle_id}" unless ent["application-identifier"] == "#{team}.#{bundle_id}"
  problems << "lists devices, so it is not an App Store profile" if profile.key?("ProvisionedDevices")
  problems << "lacks the App Group #{IOS_APP_GROUP}" unless Array(ent["com.apple.security.application-groups"]).include?(IOS_APP_GROUP)
  UI.user_error!("Profile \"#{name}\" #{problems.join(", ")}") unless problems.empty?
  name
end

# Signing entitlements of a bundle, as codesign reports them.
def signed_entitlements(path)
  out, err, status = Open3.capture3("codesign", "-d", "--entitlements", "-", "--xml", path)
  UI.user_error!("codesign could not read #{path}: #{err}") unless status.success?
  Plist.parse_xml(out) || {}
end

platform :ios do
  desc "Build an App Store signed IPA, app and widget extension, from the certificate and profiles in the environment"
  lane :ipa do
    team = ENV.fetch("APPLE_TEAM_ID")
    project = File.join(ROOT, "ios/Runner.xcodeproj")

    # The entitlements name the group as $(TIX_APP_GROUP); a different value
    # in either target would be signed in and break the widgets' shared data.
    targets = Xcodeproj::Project.open(project).targets
    IOS_SIGNING.each_key do |name|
      target = targets.find { |t| t.name == name } || UI.user_error!("No #{name} target in #{project}")
      group = target.build_configurations.find { |c| c.name == "Release" }&.build_settings&.fetch("TIX_APP_GROUP", nil)
      UI.user_error!("#{name} Release has TIX_APP_GROUP #{group.inspect}, not #{IOS_APP_GROUP}") unless group == IOS_APP_GROUP
    end

    # A throwaway keychain, deleted with the runner. Only acts on CI.
    setup_ci
    import_certificate(
      certificate_path: ENV.fetch("IOS_CERT_PATH"),
      certificate_password: ENV.fetch("IOS_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # ios/ExportOptions.plist is committed without a team or profiles, which
    # are account details; they are filled in on the runner's copy.
    plist = File.join(ROOT, "ios/ExportOptions.plist")
    options = Plist.parse_xml(plist)
    options["teamID"] = team
    options["provisioningProfiles"] = {}

    # The project keeps automatic signing for people building on their own
    # Mac. CI has no Apple ID to sign in with, so each target's Release
    # configuration is switched to its installed profile for this build only.
    IOS_SIGNING.each do |target, spec|
      path = ENV.fetch(spec[:profile])
      profile_name = check_ios_profile(path, team, spec[:bundle_id])
      install_provisioning_profile(path: path)
      update_code_signing_settings(
        path: project,
        use_automatic_signing: false,
        targets: [target],
        build_configurations: ["Release"],
        team_id: team,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name
      )
      options["provisioningProfiles"][spec[:bundle_id]] = profile_name
    end
    File.write(plist, Plist::Emit.dump(options))

    Dir.chdir(ROOT) { sh("just", "build-ipa") }

    # What TestFlight gets: the IPA, with the extension inside it and both
    # signed for their bundle id and the App Group.
    ipa = Dir[File.join(ROOT, "build/ios/ipa/*.ipa")].first || UI.user_error!("No IPA under build/ios/ipa")
    Dir.mktmpdir do |dir|
      sh("ditto", "-x", "-k", ipa, dir)
      app = Dir[File.join(dir, "Payload/*.app")].first || UI.user_error!("No app in #{ipa}")
      bundles = { app => IOS_SIGNING["Runner"], File.join(app, "PlugIns/TixWidgets.appex") => IOS_SIGNING["TixWidgets"] }
      bundles.each do |bundle, spec|
        UI.user_error!("#{File.basename(bundle)} is missing from #{ipa}") unless File.directory?(bundle)
        ent = signed_entitlements(bundle)
        UI.user_error!("#{File.basename(bundle)} is not signed for #{spec[:bundle_id]}") unless ent["application-identifier"] == "#{team}.#{spec[:bundle_id]}"
        UI.user_error!("#{File.basename(bundle)} is signed without #{IOS_APP_GROUP}") unless Array(ent["com.apple.security.application-groups"]).include?(IOS_APP_GROUP)
        UI.success("#{File.basename(bundle)}: #{spec[:bundle_id]}, #{IOS_APP_GROUP}")
      end
    end
  end

  desc "Upload an IPA to TestFlight with the App Store Connect API key in the environment"
  lane :testflight do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_BASE64"),
      is_key_content_base64: true
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: File.expand_path(options.fetch(:ipa), ROOT),
      # Processing takes minutes to an hour; the build appears in App Store
      # Connect on its own and nothing here depends on it.
      skip_waiting_for_build_processing: true
    )
  end
end
